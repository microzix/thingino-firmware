From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 19 Sep 2026 00:00:00 +0000
Subject: [PATCH] jzmmc: trace SDIO probe requests on MSC1

Trace the two points relevant to the Eufy T8410X Wi-Fi diagnosis:
manual card-present notification and dispatch of SDIO CMD0/CMD5 on the
second MMC controller. Limit the notices to MSC1 so normal SD-card
traffic stays quiet.

Signed-off-by: Codex <codex@openai.com>
---
 drivers/mmc/host/jzmmc_v12.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/mmc/host/jzmmc_v12.c b/drivers/mmc/host/jzmmc_v12.c
--- a/drivers/mmc/host/jzmmc_v12.c
+++ b/drivers/mmc/host/jzmmc_v12.c
@@ -977,6 +977,13 @@ static void jzmmc_request(struct mmc_host *mmc, struct mmc_request *mrq)
 	host->mrq = mrq;
 	host->data = mrq->data;
 	host->cmd = mrq->cmd;
+	if (host->index == 1 &&
+	    (host->cmd->opcode == 0 || host->cmd->opcode == 5))
+		dev_notice(host->dev,
+			   "trace: request CMD%d arg=0x%08X state=%d stat=0x%08X iflg=0x%08X imask=0x%08X\n",
+			   host->cmd->opcode, host->cmd->arg, host->state,
+			   msc_readl(host, STAT), msc_readl(host, IFLG),
+			   msc_readl(host, IMASK));
 
 	if (host->data)
 		dev_vdbg(host->dev, "op:%d arg:0x%08X sz:%uk\n",
@@ -1200,6 +1207,9 @@ int jzmmc_manual_detect(int index, int on)
 	if (on) {
 		dev_vdbg(host->dev, "card insert manually\n");
 		set_bit(JZMMC_CARD_PRESENT, &host->flags);
+		if (host->index == 1)
+			dev_notice(host->dev, "trace: manual insert flags=0x%lx\n",
+				   host->flags);
 #ifdef CLK_CTRL
 		jzmmc_clk_autoctrl(host, 1);
 #endif
@@ -1503,6 +1513,9 @@ static ssize_t present_store(struct device *dev,
 
 	if (strnicmp(buf, "INSERT", 6) == 0) {
 		dev_info(host->dev, "card insert via sysfs\n");
+		if (host->index == 1)
+			dev_notice(host->dev, "trace: sysfs insert flags=0x%lx\n",
+				   host->flags);
 		set_bit(JZMMC_CARD_PRESENT, &host->flags);
 		mmc_detect_change(host->mmc, 0);
 
-- 
